# Copia este archivo como .env y rellena con los datos de tu proyecto Supabase.
# Sin estas variables, la app arranca en MODO DEMO (sin login, datos en RAM).
# Con ellas, arranca en MODO SAAS (Auth + persistencia + Storage).

# Dashboard → Settings → API
SUPABASE_URL=https://zbaaptweszjbqunscldb.supabase.co
SUPABASE_ANON_KEY=             # anon / publishable — pública por diseño, va al frontend
SUPABASE_SERVICE_KEY=          # service_role / secret — SECRETO, nunca al frontend ni a git

# OPCIONAL. Solo si tu proyecto es antiguo y firma los tokens con HS256
# (Settings → API → JWT Settings → JWT Secret). Los proyectos modernos firman
# con claves asimétricas y se validan solos vía JWKS: deja esto vacío.
SUPABASE_JWT_SECRET=

# Bucket privado de Storage para los archivos subidos (créalo en el dashboard)
FORECAST_BUCKET=forecast-datasets
